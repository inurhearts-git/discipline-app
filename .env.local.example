# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret — server-only. Never prefix with NEXT_PUBLIC_, never commit.
# Used by the usage heartbeat and moderation routes to write with
# elevated privileges after the route has already verified the caller
# server-side (see lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Added in section 4 (not wired up yet in this scaffold) — YouTube search.
# YOUTUBE_API_KEY=
